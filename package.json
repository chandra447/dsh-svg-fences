{
  "name": "dsh-svg-fences",
  "version": "0.1.0",
  "description": "Render svg code fences in DeepSeek Harness chat as theme-aware inline figures, with source toggle, copy, download and zoom.",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "svg",
    "diagram",
    "figure",
    "markdown"
  ],
  "license": "MIT",
  "author": "Chandra Doredla",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "CHANGELOG.md",
    "build.mjs",
    "src",
    "THIRD-PARTY.md"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node test/verify.mjs"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chandra447/dsh-svg-fences.git"
  },
  "homepage": "https://github.com/chandra447/dsh-svg-fences#readme",
  "bugs": {
    "url": "https://github.com/chandra447/dsh-svg-fences/issues"
  }
}
